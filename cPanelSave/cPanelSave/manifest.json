{
    "manifest_version": 3,
    "name": "cPanelSave",
    "description": "Press ctrl+s to save your cPanel file",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
          "matches": ["https://*/**edit=1"],
          "js":["content.js"]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "/images/16.png",
        "32": "/images/32.png",
        "48": "/images/48.png"
    }
}